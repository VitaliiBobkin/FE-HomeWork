{
  "extends": ["airbnb"],
  "plugins": ["react", "react-hooks"],
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "max-len": "off",
    "no-console": "warn",
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-use-before-define": "error",
    "no-alert": "warn"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}




